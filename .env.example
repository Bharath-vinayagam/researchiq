# Groq LLM (Required - Get free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Neo4j Graph NoSQL (Cloud AuraDB or Local Bolt)
# AuraDB Free Cloud: neo4j+s://<dbid>.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password

# MongoDB Document NoSQL (Cloud Atlas or Local)
# Atlas Free Cloud: mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=researchiq

# External MCP Tokens (100% Optional - Public APIs work out-of-the-box without keys)
GITHUB_TOKEN=optional_github_token
HUGGINGFACE_TOKEN=optional_hf_token
SEMANTIC_SCHOLAR_API_KEY=optional_key
